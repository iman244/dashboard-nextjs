{"nodes": [{"id": "docs_superpowers_specs_2026_09_05_patient_portal_design_patient_portal_design", "label": "Patient Portal Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-05-patient-portal-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_05_patient_portal_design_patient_portal", "label": "Patient Portal", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-05-patient-portal-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Patients see their own EHR records without a Django account or staff console."}, {"id": "docs_superpowers_specs_2026_09_05_patient_portal_design_patient_sign_in_route", "label": "Patient sign-in route", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-05-patient-portal-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "National ID is used as both username and password, with a nonempty EHR result admitting the session."}, {"id": "docs_superpowers_specs_2026_09_05_patient_portal_design_patient_records_route", "label": "Patient records route", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-05-patient-portal-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records are scoped to session national ID; UI offers date range and patient type filters only."}, {"id": "docs_superpowers_specs_2026_09_05_patient_portal_design_patient_session", "label": "Patient session", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-05-patient-portal-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session storage holds the national I